      "docVersion": 7,
      "producer": { "name": "gateway", "provider": "predbat-gateway" },
      "nodes": [{
        "id": "GW-1",
        "kind": "gateway",
        "accessPaths": [{ "id": "local", "provider": "predbat-gateway" }],
        "capabilities": [{
          "capability": "battery.mode",
          "ref": 11,
          "accessPath": "local",
          "shape": "schedule",
          "tier": 1,
          "scheduleSpec": {
            "maxSlots": 2,
            "slotFields": ["target_soc", "charge_power_limit", "enable"],
            "requiresDefaultMode": true
          },
          "control": { "protocol": "modbus", "address": "schedule" }
        }]
      }]
    },
    "control": {
      "command_id": "cmd-1",
      "doc_version": 7,
      "cap_ref": 11,
      "schedule_intent": {
        "default_mode": "self_use",
        "slots": [{
